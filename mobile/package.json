{
  "name": "dugoutcall-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "test": "vitest run --pool=threads --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc",
          "expo-av",
          "@livekit/react-native-expo-plugin"
        ]
      }
    }
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@livekit/react-native": "^2.10.3",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.0.0",
    "expo": "~57.0.14",
    "expo-av": "~16.0.8",
    "expo-file-system": "~57.0.4",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "livekit-client": "^2.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "uuid": "11.1.1"
  }
}
