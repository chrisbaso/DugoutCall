PORT=8787
NODE_ENV=production
# Required in production: the server refuses to start without it.
DUGOUTCALL_TOKEN_SECRET=replace-with-a-long-random-secret
ROOM_TTL_MS=7200000
DUGOUTCALL_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Optional comma-separated browser-origin allowlist. Unset in production = no CORS.
# DUGOUTCALL_CORS_ORIGINS=https://example.com
# Required for live voice (LiveKit). Unset = voice disabled, pitch calls still work.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
