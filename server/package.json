    "livekit-server-sdk": "^2.15.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "tsx": "4.23.12",
    "typescript": "^5.5.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "body-parser": "1.20.6"
  }
}
